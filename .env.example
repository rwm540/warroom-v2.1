# ============================================================
# پیکربندی پلتفرم اتاق جنگ — متغیرهای محیطی
# این فایل را به «.env» کپی کنید و مقادیر واقعی را جایگزین نمایید.
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------------
# 🖥️ بک‌اند امن (سرور Node/Express) — پورت و آدرس اجرا
# ------------------------------------------------------------------
HOST="0.0.0.0"
PORT="8787"
NODE_ENV="development"

# تعداد لایه‌های پروکسی معکوس (Arena / Nginx / Cloudflare) برای تشخیص IP واقعی
WARROOM_TRUST_PROXY="1"

# کلید امضای نشست‌ها (برای محیط تولید الزاماً یک مقدار تصادفی و محرمانه بگذارید)
# دستور تولید:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WARROOM_SESSION_SECRET=""

# در محیط تولید (HTTPS) مقدار true بگذارید تا کوکی‌ها فقط روی HTTPS ارسال شوند
WARROOM_COOKIE_SECURE="false"

# طول عمر نشست‌ها (ساعت)
WARROOM_SESSION_TTL_HOURS="12"
WARROOM_ADMIN_SESSION_TTL_HOURS="4"

# ------------------------------------------------------------------
# 🛡️ لایه‌های ضدحمله (DDoS / Brute-force / Rate Limit)
# ------------------------------------------------------------------
WARROOM_RATE_GLOBAL="600"          # سقف درخواست هر IP در دقیقه
WARROOM_RATE_AUTH="30"             # سقف درخواست مسیرهای ورود/ثبت‌نام (شبکه‌های اشتراکی)
WARROOM_RATE_RESET="8"             # سقف «درخواست تغییر رمز» در دقیقه
WARROOM_RATE_ADMIN="180"           # سقف درخواست مسیرهای مدیریتی
WARROOM_RATE_BURST="80"            # ظرفیت انفجاری هر IP (Token Bucket)
WARROOM_MAX_INFLIGHT_IP="24"       # سقف درخواست هم‌زمان هر IP
WARROOM_MAX_SOCKETS_IP="64"        # سقف اتصال هم‌زمان هر IP
WARROOM_VIOLATION_THRESHOLD="150"  # آستانه تخلف برای مسدودسازی موقت IP (IPهای خصوصی/لوکال مسدود نمی‌شوند)
WARROOM_BAN_MINUTES="15"           # مدت مسدودسازی IP متخلف (دقیقه)
WARROOM_LOGIN_MAX_ATTEMPTS="6"     # تعداد تلاش ناموفق پیش از قفل حساب
WARROOM_LOGIN_LOCK_MINUTES="15"    # مدت قفل حساب (دقیقه)
WARROOM_BODY_LIMIT="192kb"         # سقف حجم بدنه درخواست
WARROOM_MAINTENANCE="false"        # true = سامانه در حالت تعمیرات

# فهرست سفید/سیاه IP (با کاما جدا کنید)
WARROOM_ALLOWED_IPS=""
WARROOM_BLOCKED_IPS=""

# ------------------------------------------------------------------
# 🔐 امنیت مرورگر
# ------------------------------------------------------------------
WARROOM_HSTS="false"              # در تولید (HTTPS) true کنید
WARROOM_CORS_ORIGINS=""           # دامنه‌های مجاز اضافی (اختیاری، با کاما)
# WARROOM_CSP="default-src 'self'; ..."   # در صورت نیاز به سیاست امنیتی سفارشی

# ------------------------------------------------------------------
# 👤 مدیر کل سامانه (Bootstrap)
# ------------------------------------------------------------------
WARROOM_ADMIN_NATIONAL_CODE="0012345678"
# ⚠️ رمز نخستین ورود مدیر — پیش از انتشار عمومی حتماً تغییر دهید
WARROOM_ADMIN_INITIAL_PASSWORD="admin"
# الزام تغییر رمز در نخستین ورود (توصیه: true)
WARROOM_ADMIN_FORCE_CHANGE="true"

# ------------------------------------------------------------------
# ☁️ Supabase (اختیاری — لایه ذخیره‌سازی ابری)
#   اگر پیکربندی نشود، بک‌اند از پایگاه‌داده فایلی امن (server/data) استفاده می‌کند.
#   پیش از اجرا، اسکریپت Query.sql را در SQL Editor پروژه Supabase اجرا کنید.
# ------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# کلید عمومی فرمت جدید (Publishable Key) — برای مرورگر
VITE_SUPABASE_PUBLIC_KEY="sb_publishable_..."

# کلید anon فرمت قدیم (JWT) — پشتیبان، در صورت نبود کلید بالا استفاده می‌شود
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# 🛡️ کلید service_role — فقط روی سرور استفاده می‌شود و «هرگز» نباید در مرورگر
#    یا مخزن گیت قرار گیرد. این کلید دسترسی کامل به جدول‌های امنیتی می‌دهد.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------
# 🗂️ مسیرها (اختیاری)
# ------------------------------------------------------------------
# WARROOM_DATA_DIR="/var/lib/warroom"      # مسیر پایگاه‌داده فایلی
# WARROOM_STATIC_DIR="./dist"              # مسیر نسخه ساخته‌شده فرانت‌اند
# WARROOM_API_BASE="/api"                  # آدرس پایه API در فرانت‌اند (VITE_*)
# VITE_API_BASE="/api"

# ------------------------------------------------------------------
# legacy (AI Studio)
# ------------------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
