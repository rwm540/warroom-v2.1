# ============================================================
# پیکربندی پلتفرم اتاق جنگ — متغیرهای محیطی
# این فایل را به «.env» کپی کنید و مقادیر واقعی را جایگزین نمایید.
# ============================================================

# ---------- Supabase (دیتابیس ابری) ----------
# از داشبورد پروژه Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# کلید عمومی فرمت جدید (Publishable Key) — اولویت اول در برنامه
VITE_SUPABASE_PUBLIC_KEY="sb_publishable_..."

# کلید anon فرمت قدیم (JWT) — پشتیبان، در صورت نبود کلید بالا استفاده می‌شود
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# نکته: پیش از اجرا، اسکریپت Query.sql (یا supabase/schema.sql) را در SQL Editor
# پروژه Supabase اجرا کنید. اگر مقادیر خالی باشند، برنامه در «حالت محلی»
# (localStorage) اجرا می‌شود.

# ----------legacy (AI Studio) ----------
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
